# Telegram
TELEGRAM_BOT_TOKEN=            # от @BotFather
MINIAPP_URL=                   # https://your-app.vercel.app/miniapp/dashboard

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # Settings -> API -> service_role (секретный!)

# Google Drive OAuth (Google Cloud Console -> OAuth Client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=           # https://your-app.vercel.app/api/drive/oauth-callback

# Qwen (DashScope)
QWEN_API_KEY=

# Cron
CRON_SECRET=                   # произвольная строка, для защиты /api/cron/*
